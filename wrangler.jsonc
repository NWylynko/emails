{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emails",
  "main": "worker.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  // Explicit, or every deploy warns that enabling workers_dev implicitly
  // enables per-version preview URLs. Dashboard had them disabled.
  "preview_urls": false,
  "observability": { "enabled": true },
  "placement": { "mode": "smart" },
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Bind the dev server to all interfaces, not just loopback — the box is
  // developed on remotely, so localhost-only leaves it unreachable.
  "dev": { "ip": "0.0.0.0" },
  "env": {
    "development": {
      "name": "emails-dev",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "1b02e5c500e54d719ff1ab29ce9bf2ea"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "email-attachments"
        }
      ],
      // No "ai" binding in development, on purpose. Workers AI can't run
      // locally: wrangler reaches it by uploading a proxy Worker, which makes
      // every `pnpm dev` need a Cloudflare login. Local dev serves a fake
      // summary instead (src/app/(authenticated)/email/[id]/ai/page.tsx), so dev
      // needs only an Infisical login. Guarded by
      // src/localDev/localDevStartsWithoutCloudflareLogin.test.ts.
    },
    "production": {
      "name": "emails",
      "routes": [
        {
          // PLACEHOLDER: the real hostname is not committed. Set it to the
          // production hostname (same value as SITE_URL) before deploying.
          "pattern": "emails.example.com",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "3c425a8db80648cc9b5049a3d709421e",
          "localConnectionString": "postgresql://placeholder:placeholder@localhost:5432/placeholder"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "email-attachments"
        }
      ],
      "ai": { "binding": "AI", "remote": true },
    }
  }
}
