{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emails",
  "main": "worker.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "observability": { "enabled": true },
  "placement": { "mode": "smart" },
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "env": {
    "development": {
      "name": "emails-dev",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "1b02e5c500e54d719ff1ab29ce9bf2ea"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "email-attachments"
        }
      ],
      "ai": { "binding": "AI" },
    },
    "production": {
      "name": "emails",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "3c425a8db80648cc9b5049a3d709421e",
          "localConnectionString": "postgresql://placeholder:placeholder@localhost:5432/placeholder"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ATTACHMENTS",
          "bucket_name": "email-attachments"
        }
      ],
      "ai": { "binding": "AI" },
    }
  }
}
