# Schema for this project's environment variables.
#
# COMMITTED, and contains no secret values — names, types and validation only.
# Values live in Infisical (project "emails", environments dev and prod) and are
# injected by the Infisical CLI:
#
#   infisical run --env=dev -- pnpm preview
#
# Nothing sensitive is written to disk. Run `infisical login` once per machine.
#
# Not listed here, because they are Cloudflare bindings rather than variables:
# HYPERDRIVE (Postgres), ATTACHMENTS (R2), AI (Workers AI), ASSETS.
#
# @generateTsTypes(path=env.d.ts)
# @defaultSensitive=inferFromPrefix('NEXT_PUBLIC_')
# ---

# --- Auth ---

# Clerk publishable key.
#
# NOT runtime-resolved on the client, whatever @dynamic suggests. Clerk's SDK
# compiles to `props.publishableKey || "<literal>"`, so whichever value is
# present at `next build` is inlined into the client chunks and shipped. Verify
# with: grep -rhoE 'pk_(live|test)_[A-Za-z0-9=]+' .open-next/assets/
#
# That makes the build environment decisive: a build under prod values serves
# production Clerk even from `wrangler dev`, and production Clerk rejects every
# non-emails.wylynko.me origin with `origin_invalid`. See BUILD_INFISICAL_ENV in
# AGENTS.md.
# @docs("Clerk dashboard", https://dashboard.clerk.com/)
# @dynamic @required @type=string(startsWith=pk_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# @required @type=string(startsWith=sk_)
CLERK_SECRET_KEY=

# --- Private website editing ---

# These values stay private, dynamic, and log-redacted. Per-item response
# scanning allows the deliberate authorized credential handoff and the signed-in
# editor identity prop; global leak protection remains enabled.

# Explicit comma-separated Clerk user IDs allowed to edit this website through
# T3. Empty disables the widget; ordinary website access does not grant editing.
# @dynamic @sensitive={preventLeaks=false} @required=false @type=string
T3_CHAT_EDITOR_USER_IDS=

# Private HTTPS T3 origin, delivered only to an authorized editor on opening chat.
# @dynamic @sensitive={preventLeaks=false} @required=false @type=string
T3_CHAT_SERVER_URL=

# Pre-issued T3 bearer. Read inside the authorized request, never from layout props.
# @dynamic @sensitive={preventLeaks=false} @required=false @type=string
T3_CHAT_ACCESS_TOKEN=

# ID of this website's existing project in the configured T3 environment.
# @dynamic @sensitive={preventLeaks=false} @required=false @type=string
T3_CHAT_PROJECT_ID=

# Static routing config, safe for the browser. The value here IS the default —
# there is no fallback in code.
# @public
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# --- The /v1 CLI API ---

# Shared secret for emails-cli. Must match `api_token` in
# ~/.config/emails-cli/config.toml for whichever environment the CLI points at.
# @required @type=string
API_TOKEN=

# --- Outbound mail ---

# Used only on the forward-on path, when Nick mails an inbox that has a receiver
# set. Ordinary inbound mail never touches Resend.
# @docs("Resend dashboard", https://resend.com/api-keys)
# @required @type=string(startsWith=re_)
RESEND_KEY=

# --- Notifications ---

# Pusher Channels: the "updates" ping that lights up the website's refresh
# button. APP_ID and SECRET are server-only; KEY and CLUSTER are handed to the
# browser as props by the authenticated layout, which is why neither needs a
# NEXT_PUBLIC_ prefix.
# @docs("Pusher dashboard", https://dashboard.pusher.com/)
# @required @type=string
PUSHER_APP_ID=
# KEY and CLUSTER are public by design — the browser needs both to subscribe,
# and they are handed to the client as props. Marking them public also stops the
# leak scanner flagging them: CLUSTER's value is three characters ("ap4"), which
# appears by chance in almost any minified chunk.
# @public @required @type=string
PUSHER_KEY=
# @public @required @type=string
PUSHER_CLUSTER=
# Server-only. This one is the actual secret.
# @required @type=string
PUSHER_SECRET=

# Pusher Beams: push notifications to the installed web app. The instance id is
# public — the browser SDK needs it to register a device — and is passed to the
# client as a prop. BEAMS_SECRET is the actual secret and stays on the Worker.
# @public @required @type=string
BEAMS_INSTANCE_ID=
# @required @type=string
BEAMS_SECRET=

# Push by Techulus: push notifications to Nick's phone.
# @docs("Push by Techulus", https://push.techulus.com/)
# @required @type=string
TECHULUS_API_KEY=

# --- Local development only ---

# Hyperdrive cannot be emulated locally without an explicit Postgres connection
# string; miniflare errors rather than reaching the remote database, which is
# what stops `wrangler dev` ever touching production. Set in the dev environment
# only, pointing at the ep-twilight-sunset clone. Absent in prod, where the
# Worker uses the Hyperdrive binding, hence not required.
# @required=false @type=string
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Connection string for drizzle-kit only — migrations and the dev seeder. The
# running app NEVER reads this: it reaches Postgres through the HYPERDRIVE
# binding, which is why this is not called DATABASE_URL. That name existed
# before the Hyperdrive cutover and was deleted with it; reusing it would imply
# the app takes a connection string again.
#
# This exists because Hyperdrive is a Worker binding: it does not exist outside
# a running Worker, so CI and a laptop have nothing to connect through, and
# Cloudflare does not return the origin password (the API omits the field
# entirely). It is a second, readable copy of a credential that already exists
# but cannot be read back — not a new one.
#
# Prefer the **unpooled** endpoint (no `-pooler` in the host), though DDL does
# work through the pooled one — measured, including CREATE INDEX CONCURRENTLY.
# The point is to keep a long migration off a pooled slot the app is using.
#
# Set in dev (the ep-twilight-sunset clone) and in prod (ep-purple-bread, real
# mail). Not required, because neither the build nor the Worker consumes it.
# @required=false @sensitive @type=string(startsWith=postgres)
MIGRATIONS_DATABASE_URL=

# Which .env file Next loads at runtime in dev (OpenNext convention).
# @public @required=false
NEXTJS_ENV=
