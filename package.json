{
  "name": "emails",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "infisical run --env=dev --projectId=39a9c656-043d-41b0-bc73-a288c8b22baa -- next dev -H 0.0.0.0",
    "preview": "pnpm preview:build && infisical run --env=dev --projectId=39a9c656-043d-41b0-bc73-a288c8b22baa -- opennextjs-cloudflare preview --env=development",
    "preview:build": "BUILD_INFISICAL_ENV=dev opennextjs-cloudflare build --env=development",
    "build": "infisical run --env=${BUILD_INFISICAL_ENV:-prod} --projectId=39a9c656-043d-41b0-bc73-a288c8b22baa -- next build",
    "start": "infisical run --env=prod --projectId=39a9c656-043d-41b0-bc73-a288c8b22baa -- next start",
    "ci:migrate": "infisical run --env=prod --projectId=39a9c656-043d-41b0-bc73-a288c8b22baa -- drizzle-kit migrate",
    "ci:build": "export INFISICAL_TOKEN=$(infisical login --method=universal-auth --silent --plain) && pnpm ci:migrate && opennextjs-cloudflare build --env=production",
    "ci:deploy": "OPEN_NEXT_DEPLOY=true wrangler deploy --env production",
    "test": "infisical run --env=dev --projectId=39a9c656-043d-41b0-bc73-a288c8b22baa -- node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:dev": "infisical run --env=dev --projectId=39a9c656-043d-41b0-bc73-a288c8b22baa -- drizzle-kit migrate",
    "db:migrate:prod": "infisical run --env=prod --projectId=39a9c656-043d-41b0-bc73-a288c8b22baa -- drizzle-kit migrate",
    "db:studio:dev": "infisical run --env=dev --projectId=39a9c656-043d-41b0-bc73-a288c8b22baa -- drizzle-kit studio",
    "db:seed:dev": "infisical run --env=dev --projectId=39a9c656-043d-41b0-bc73-a288c8b22baa -- node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/database/seed/seedDevDatabase.ts",
    "typecheck": "infisical run --env=dev --projectId=39a9c656-043d-41b0-bc73-a288c8b22baa -- next typegen && pnpm generate-types && tsc --noEmit",
    "generate-types": "wrangler types --env-interface CloudflareEnv --env=development"
  },
  "packageManager": "pnpm@11.15.1",
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
    "@hookform/resolvers": "^7.0.5",
    "@pusher/push-notifications-web": "^1.1.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "^0.45.4",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^1.71.0",
    "mailparser": "^3.14.3",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "postgres": "^4.1.0",
    "pusher-js": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "resend": "^6.38.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@infisical/cli": "^0.45.6",
    "@opennextjs/cloudflare": "^1.20.16",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/hast": "^3.0.5",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@varlock/nextjs-integration": "^1.2.5",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "varlock": "^1.24.0",
    "wrangler": "^4.160.0"
  }
}
